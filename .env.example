# Salin ke .env lalu sesuaikan. Bun memuat .env otomatis dari folder root repo.
# Tidak ada API key yang dibutuhkan: semua data diambil dari endpoint publik Binance.

# ---------------------------------------------------------------- server
PORT=8090
HOST=0.0.0.0
# path relatif terhadap root repo
DATA_DIR=apps/server/data
MODELS_DIR=apps/server/models/current
WEB_DIST=apps/web/dist

# ---------------------------------------------------------------- pasar
SYMBOL=SOLUSDT
# Konteks BTC untuk fitur btc_* (manifest.btc_symbol menimpa nilai ini kalau ada).
# Data BTC tidak pernah dipakai membuka order; order tetap mengikuti SYMBOL.
BTC_SYMBOL=BTCUSDT

# Endpoint data pasar Binance (tanpa autentikasi).
# Default memakai endpoint publik yang paling jarang diblokir ISP:
#   spot    : data-stream.binance.vision / data-api.binance.vision
#   futures : fstream.binance.com/market/ws (jalur data pasar, bukan /ws)
BINANCE_SPOT_WS=wss://data-stream.binance.vision/ws
BINANCE_SPOT_REST=https://data-api.binance.vision
BINANCE_FUTURES_WS=wss://fstream.binance.com/market/ws
BINANCE_FUTURES_REST=https://fapi.binance.com

# ---------------------------------------------------------------- sinyal
# Harus sama dengan pengaturan saat mining merekam data (log: thr_pct=85, thr_streak=12).
# Kalau diubah, fitur sig_* tidak lagi sepadan dengan data latih model.
SIGNAL_DOMINANCE_PCT=85
SIGNAL_STREAK=12
TRADE_WINDOW=50

# ---------------------------------------------------------------- simulasi
# 240 menit lookback fitur + 60 menit cadangan urutan = 305 menit sebelum sinyal pertama.
# Menit histori minimum sebelum model mulai memberi sinyal. Model dengan fitur btc_* juga
# menunggu BTC futures/spot mencapai jumlah menit yang sama.
# Batas bawah keras 300; nilai lebih kecil otomatis dinaikkan dan diberi peringatan saat boot.
MIN_HISTORY_MINUTES=305
BUFFER_MINUTES=900
# false = mulai dengan sistem OFF (tidak ada entri baru)
AUTO_START=true
# live menjalankan Binance realtime; replay memutar data validasi historis
INITIAL_MODE=live
